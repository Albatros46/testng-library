<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- "regression" grubu, "performance" grubu hariç. Çalıştır: mvn test -Dsuite=regression -->
<suite name="Library - Regression" verbose="1">

    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
                <exclude name="performance"/>
            </run>
        </groups>
        <packages>
            <package name="com.servet.library"/>
        </packages>
    </test>
</suite>
