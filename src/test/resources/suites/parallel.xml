<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Sınıflar paralel çalışır: aynı sınıfın metotları aynı thread'de kalır.
  BorrowFlowTest paylaşılan state kullandığı için parallel="methods" ona uygun DEĞİL.
  Çalıştır: mvn test -Dsuite=parallel
-->
<suite name="Library - Parallel" parallel="classes" thread-count="3" data-provider-thread-count="3" verbose="1">

    <test name="Parallel Tests">
        <classes>
            <class name="com.servet.library.IsbnValidatorTest"/>
            <class name="com.servet.library.LibraryRulesTest"/>
            <class name="com.servet.library.BorrowFlowTest"/>
        </classes>
    </test>
</suite>
